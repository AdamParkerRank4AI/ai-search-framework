# GoDaddy API credentials
# Get yours at: https://developer.godaddy.com/keys
GODADDY_API_KEY=your_godaddy_key_here
GODADDY_API_SECRET=your_godaddy_secret_here

# NameCheap API credentials
# Get yours at: https://www.namecheap.com/support/api/intro/
# Note: You need to whitelist your IP in the NameCheap dashboard
NAMECHEAP_API_USER=your_namecheap_username
NAMECHEAP_API_KEY=your_namecheap_api_key
NAMECHEAP_CLIENT_IP=your_public_ip_address
