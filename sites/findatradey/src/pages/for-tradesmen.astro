---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'For Tradesmen — Get Vetted Local Leads | FindATradey';
const description = 'Gas Safe / NICEIC / OFTEC / MCS registered? Get up to 3 vetted local leads per week. Pay only when you win the job. No retainer, no contract, no spam-volume.';
---
<BaseLayout title={title} description={description}>
  <section class="bg-gradient-to-b from-brand-50 to-white border-b border-ink-900/10">
    <div class="container-wide py-12 md:py-16">
      <p class="text-xs font-bold uppercase tracking-wider text-brand-700">For tradesmen</p>
      <h1 class="mt-2 text-4xl font-bold text-ink-900">Vetted local leads. Pay only when you win.</h1>
      <p class="mt-4 text-lg text-ink-700 max-w-2xl">
        We send you up to three pre-qualified local jobs per week. You only pay when you win the job. No retainer, no monthly subscription, no spam-volume directory listing nobody uses.
      </p>
    </div>
  </section>

  <section class="container-wide py-12 grid md:grid-cols-2 gap-10">
    <div>
      <h2 class="text-2xl font-semibold text-ink-900">How it works</h2>
      <ol class="mt-4 space-y-3 text-ink-700 list-decimal pl-5">
        <li>You apply, we cross-check your registration on Gas Safe / NICEIC / NAPIT / ELECSA / OFTEC / MCS.</li>
        <li>You agree your service area (postcodes you cover) and the trade categories you take.</li>
        <li>When a homeowner submits a matching job, we ring you alongside two other vetted engineers in your area.</li>
        <li>First to confirm gets the customer's contact. We don't share details with the others.</li>
        <li>You quote, you do the work. We ring the homeowner afterwards to confirm completion. You pay £25–60 per won job, billed weekly.</li>
      </ol>
    </div>
    <div class="bg-white border border-ink-900/10 rounded-xl p-6">
      <h2 class="text-2xl font-semibold text-ink-900">Why work with us</h2>
      <ul class="mt-4 space-y-3 text-ink-700">
        <li class="flex gap-3"><span class="text-brand-600 font-bold">✓</span><span><strong>No subscription.</strong> Pay only on won jobs, billed Monday for the previous week.</span></li>
        <li class="flex gap-3"><span class="text-brand-600 font-bold">✓</span><span><strong>No spam volume.</strong> Up to 3 pre-qualified leads per week, not 30 unread directory enquiries.</span></li>
        <li class="flex gap-3"><span class="text-brand-600 font-bold">✓</span><span><strong>No competing with 20 others.</strong> The customer gets only your details once you confirm.</span></li>
        <li class="flex gap-3"><span class="text-brand-600 font-bold">✓</span><span><strong>Honest pricing.</strong> Lead fees: plumber £25, electrician £25, heating £35, install / heat pump £45–60.</span></li>
        <li class="flex gap-3"><span class="text-brand-600 font-bold">✓</span><span><strong>Lead refunds</strong> for genuinely unconvertable jobs (homeowner not available, scope changed materially, etc.).</span></li>
      </ul>
    </div>
  </section>

  <section class="container-wide py-12 border-t border-ink-900/10">
    <h2 class="text-2xl font-semibold text-ink-900">Apply</h2>
    <p class="mt-3 text-ink-700 max-w-2xl">
      Tell us your trade and your postcodes. We'll come back within 48 hours with verification and onboarding.
    </p>
    <form class="mt-6 max-w-xl bg-white border border-ink-900/10 rounded-xl p-6 space-y-4" action="https://tally.so/r/REPLACE_WITH_TALLY_TRADE_FORM_ID" method="POST">
      <div>
        <label for="company" class="block text-sm font-medium text-ink-900 mb-1">Trading name</label>
        <input type="text" id="company" name="company" required class="w-full border border-ink-900/20 rounded-md px-3 py-2 text-base" />
      </div>
      <div>
        <label for="trade" class="block text-sm font-medium text-ink-900 mb-1">Primary trade</label>
        <select id="trade" name="trade" class="w-full border border-ink-900/20 rounded-md px-3 py-2 text-base">
          <option>Plumber</option>
          <option>Electrician</option>
          <option>Heating engineer</option>
        </select>
      </div>
      <div>
        <label for="register_id" class="block text-sm font-medium text-ink-900 mb-1">Register ID (Gas Safe / NICEIC / NAPIT / ELECSA / OFTEC / MCS)</label>
        <input type="text" id="register_id" name="register_id" required class="w-full border border-ink-900/20 rounded-md px-3 py-2 text-base" />
      </div>
      <div>
        <label for="postcodes" class="block text-sm font-medium text-ink-900 mb-1">Postcodes you cover</label>
        <input type="text" id="postcodes" name="postcodes" required placeholder="e.g. CO1, CO2, CO3" class="w-full border border-ink-900/20 rounded-md px-3 py-2 text-base" />
      </div>
      <div>
        <label for="phone" class="block text-sm font-medium text-ink-900 mb-1">Phone</label>
        <input type="text" id="phone" name="phone" required class="w-full border border-ink-900/20 rounded-md px-3 py-2 text-base" />
      </div>
      <button type="submit" class="btn-primary w-full">Apply to receive leads</button>
    </form>
  </section>
</BaseLayout>
