---
import BaseLayout from '../layouts/BaseLayout.astro';
import { districts, getDistrictsByCounty } from '../lib/data';

const trades = [
  { href: '/plumber/', label: 'Plumbers', desc: 'Emergency, leak detection, drainage' },
  { href: '/electrician/', label: 'Electricians', desc: 'EICR, rewire, fuse box, emergency' },
  { href: '/heating-engineer/', label: 'Heating engineers', desc: 'Boiler service, repair, install, heat pumps' },
];

const byCounty = getDistrictsByCounty();
const counties = Object.entries(byCounty).map(([slug, ds]) => ({
  slug,
  name: ds[0].county,
  districts: ds,
}));

const title = 'FindATradey — Three vetted UK tradesmen, no spam';
const description = 'UK trade-finder: emergency plumbers, NICEIC electricians, Gas Safe heating engineers. Three verified local engineers per job, free for homeowners, no spam.';
---
<BaseLayout title={title} description={description}>
  <section class="bg-gradient-to-b from-brand-50 to-white border-b border-ink-900/10">
    <div class="container-wide py-16 md:py-24">
      <p class="text-xs font-bold uppercase tracking-wider text-brand-700">UK trade finder</p>
      <h1 class="mt-3 text-4xl md:text-5xl font-bold text-ink-900 leading-tight max-w-3xl">
        Three vetted local tradesmen. No spam. Pay only when the job's done.
      </h1>
      <p class="mt-5 text-lg text-ink-700 max-w-2xl">
        Tell us about your job. Within an hour we'll match you with up to three verified local engineers — Gas Safe, NICEIC, OFTEC or MCS registered. We don't sell your number. No follow-up calls once your job's done.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="#start" class="btn-primary">Get 3 vetted quotes</a>
        <a href="/how-we-vet-tradesmen/" class="btn-secondary">How we vet</a>
      </div>
    </div>
  </section>

  <section id="start" class="container-wide py-12">
    <h2 class="text-2xl font-semibold text-ink-900 mb-6">What do you need?</h2>
    <div class="grid md:grid-cols-3 gap-4">
      {trades.map((t) => (
        <a href={t.href} class="block bg-white border border-ink-900/10 rounded-xl p-6 hover:border-brand-300 transition no-underline">
          <p class="text-lg font-semibold text-ink-900">{t.label}</p>
          <p class="mt-2 text-ink-700 text-sm">{t.desc}</p>
          <p class="mt-4 text-brand-700 text-sm font-medium">Find one →</p>
        </a>
      ))}
    </div>
  </section>

  <section class="container-wide py-12 grid md:grid-cols-3 gap-8 border-t border-ink-900/10">
    <div>
      <p class="text-3xl font-bold text-brand-700">100%</p>
      <p class="mt-2 font-semibold text-ink-900">Register-verified</p>
      <p class="mt-1 text-sm text-ink-700">Every engineer cross-checked against Gas Safe, NICEIC, OFTEC or MCS — refreshed weekly.</p>
    </div>
    <div>
      <p class="text-3xl font-bold text-brand-700">3</p>
      <p class="mt-2 font-semibold text-ink-900">Engineers per job</p>
      <p class="mt-1 text-sm text-ink-700">Closest, fastest, best-reviewed. Not 20 spam calls.</p>
    </div>
    <div>
      <p class="text-3xl font-bold text-brand-700">£0</p>
      <p class="mt-2 font-semibold text-ink-900">For homeowners</p>
      <p class="mt-1 text-sm text-ink-700">Free service. Engineers pay only when they win the job.</p>
    </div>
  </section>

  <section class="container-wide py-12 border-t border-ink-900/10">
    <h2 class="text-2xl font-semibold text-ink-900 mb-6">Find a tradesman in your area</h2>
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-4">
      {counties.map((c) => (
        <a href={`/county/${c.slug}/`} class="block bg-white border border-ink-900/10 rounded-xl p-5 hover:border-brand-300 transition no-underline">
          <p class="font-semibold text-ink-900">{c.name}</p>
          <p class="mt-2 text-xs text-ink-500">{c.districts.length} {c.districts.length === 1 ? 'town' : 'towns'} covered</p>
          <ul class="mt-3 text-sm text-ink-700 space-y-1">
            {c.districts.slice(0, 3).map((d) => (
              <li>{d.town} ({d.postcode_district})</li>
            ))}
          </ul>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
