---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { districts } from '../../lib/data';

const services = [
  { slug: 'eicr-electrician', label: 'EICR electrician', desc: 'Landlord reports, Electrical Installation Condition Reports' },
  { slug: 'house-rewire', label: 'Full house rewire', desc: '3-bed and 4-bed rewires, Part P certified' },
  { slug: 'emergency-electrician', label: 'Emergency electrician', desc: '24h fault diagnosis, power loss, tripping circuits' },
  { slug: 'consumer-unit', label: 'Consumer unit / fuse box', desc: 'Replacement, RCBO upgrade, 18th Edition' },
];

const title = 'Electricians UK — EICR, Rewire, Emergency, Fuse Box | FindATradey';
const description = 'Find a NICEIC, NAPIT or ELECSA registered electrician in your UK town. EICR landlord reports, rewires, emergency, fuse box replacement. Three vetted quotes within an hour.';
---
<BaseLayout title={title} description={description}>
  <section class="bg-gradient-to-b from-brand-50 to-white border-b border-ink-900/10">
    <div class="container-wide py-12 md:py-16">
      <p class="text-xs font-bold uppercase tracking-wider text-brand-700">Electricians</p>
      <h1 class="mt-2 text-4xl font-bold text-ink-900">UK electricians — EICR, rewire, emergency, consumer unit</h1>
      <p class="mt-4 text-lg text-ink-700 max-w-2xl">Verified NICEIC / NAPIT / ELECSA registered electricians across the UK. Pick a service.</p>
    </div>
  </section>

  <section class="container-wide py-12 grid md:grid-cols-2 lg:grid-cols-4 gap-4">
    {services.map((s) => (
      <a href={`/${s.slug}/`} class="block bg-white border border-ink-900/10 rounded-xl p-6 hover:border-brand-300 transition no-underline">
        <p class="text-lg font-semibold text-ink-900">{s.label}</p>
        <p class="mt-2 text-ink-700 text-sm">{s.desc}</p>
      </a>
    ))}
  </section>

  <section class="container-wide py-8 border-t border-ink-900/10">
    <h2 class="text-2xl font-semibold text-ink-900 mb-6">Electricians by town</h2>
    <div class="grid sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3">
      {districts.map((d) => (
        <a href={`/emergency-electrician/${d.slug}/`} class="block border border-ink-900/10 rounded-lg p-3 hover:border-brand-300 transition no-underline">
          <p class="font-medium text-ink-900">{d.town}</p>
          <p class="text-xs text-ink-500 mt-1">{d.postcode_district} · {d.county}</p>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
