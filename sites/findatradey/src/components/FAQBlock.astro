---
import type { FAQ } from '../lib/types';

export interface Props {
  faqs: FAQ[];
  heading?: string;
}

const { faqs, heading = 'Frequently asked questions' } = Astro.props;
---
<section class="bg-white border border-ink-900/10 rounded-xl p-5 md:p-6">
  <h2 class="text-xl font-semibold text-ink-900 mb-4">{heading}</h2>
  <div class="space-y-3">
    {faqs.map((faq) => (
      <details class="group border border-ink-900/10 rounded-lg p-4 [&_summary]:cursor-pointer">
        <summary class="font-medium text-ink-900 list-none flex items-start justify-between gap-3">
          <span>{faq.q}</span>
          <span class="text-brand-700 group-open:rotate-180 transition-transform select-none" aria-hidden="true">▾</span>
        </summary>
        <p class="mt-3 text-ink-700 text-sm leading-relaxed">{faq.a}</p>
      </details>
    ))}
  </div>
</section>
