---
import type { District } from '../lib/types';
import { getNeighbouringDistricts, districts as allDistricts } from '../lib/data';

export interface Props {
  district: District;
  pathPrefix: string; // e.g. "/emergency-plumber"
  pageLabel: string; // e.g. "emergency plumber"
}

const { district, pathPrefix, pageLabel } = Astro.props;
const neighbours = getNeighbouringDistricts(district);

// If we don't have neighbours in our dataset, link to other districts in the same county.
const fallback = allDistricts.filter((d) =>
  d.county_slug === district.county_slug && d.slug !== district.slug
);
const related = neighbours.length > 0 ? neighbours : fallback;
---
{related.length > 0 && (
  <section class="bg-white border border-ink-900/10 rounded-xl p-5 md:p-6">
    <h2 class="text-xl font-semibold text-ink-900 mb-4">Looking for a {pageLabel} nearby?</h2>
    <ul class="grid sm:grid-cols-2 md:grid-cols-3 gap-2">
      {related.map((d) => (
        <li>
          <a href={`${pathPrefix}/${d.slug}/`} class="block border border-ink-900/10 rounded-lg p-3 hover:border-brand-300 transition no-underline">
            <span class="block font-medium text-ink-900">{d.town}</span>
            <span class="block text-xs text-ink-500">{d.postcode_district} · {d.county}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
)}
