---
import type { District } from '../lib/types';

export interface Props {
  district: District;
  serviceLabel: string; // e.g. "Emergency plumber"
  factLine: string; // e.g. "47 Gas Safe registered engineers cover Battersea (SW11)..."
  verdict: string; // one-line value statement
}

const { district, serviceLabel, factLine, verdict } = Astro.props;
---
<section class="bg-gradient-to-b from-brand-50 to-white border-b border-ink-900/10">
  <div class="container-wide py-10 md:py-14">
    <p class="text-xs font-bold uppercase tracking-wider text-brand-700">
      {district.town} · {district.postcode_district} · {district.county}
    </p>
    <h1 class="mt-2 text-3xl md:text-4xl font-bold text-ink-900 leading-tight">
      {serviceLabel} in {district.town} ({district.postcode_district})
    </h1>
    <p class="mt-4 text-lg text-ink-700 max-w-2xl">{verdict}</p>
    <p class="mt-3 text-sm text-ink-500 max-w-2xl">{factLine}</p>
    <div class="mt-6 flex flex-wrap gap-3">
      <a href="#lead-form" class="btn-primary">Get 3 vetted quotes</a>
      <a href="#prices" class="btn-secondary">See typical prices</a>
    </div>
  </div>
</section>
