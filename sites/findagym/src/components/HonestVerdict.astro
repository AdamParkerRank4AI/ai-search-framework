---
import type { Gym } from '../lib/types';

export interface Props {
  gym: Gym;
}

const { gym } = Astro.props;
---
<section class="grid md:grid-cols-3 gap-4">
  <div class="bg-white border border-accent-500/30 rounded-xl p-5">
    <p class="text-xs uppercase tracking-wider text-accent-700 font-bold">Best for</p>
    <ul class="mt-3 space-y-2 text-sm text-ink-900">
      {gym.best_for.map((b) => (
        <li class="flex gap-2"><span class="text-accent-700 font-bold">+</span><span>{b}</span></li>
      ))}
    </ul>
  </div>
  <div class="bg-white border border-brand-300 rounded-xl p-5">
    <p class="text-xs uppercase tracking-wider text-brand-700 font-bold">Underrated for</p>
    <ul class="mt-3 space-y-2 text-sm text-ink-900">
      {gym.underrated_for.map((u) => (
        <li class="flex gap-2"><span class="text-brand-700 font-bold">★</span><span>{u}</span></li>
      ))}
    </ul>
    <p class="mt-3 text-xs text-ink-500">The surprising win nobody mentions in the brand's marketing.</p>
  </div>
  <div class="bg-white border border-ink-700/30 rounded-xl p-5">
    <p class="text-xs uppercase tracking-wider text-ink-700 font-bold">Worst for</p>
    <ul class="mt-3 space-y-2 text-sm text-ink-900">
      {gym.worst_for.map((w) => (
        <li class="flex gap-2"><span class="text-ink-700 font-bold">−</span><span>{w}</span></li>
      ))}
    </ul>
    <p class="mt-3 text-xs text-ink-500">We don't soften this. Trust comes from honesty.</p>
  </div>
</section>
