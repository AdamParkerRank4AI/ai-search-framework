---
import type { Gym } from '../lib/types';
import { fmtMoney } from '../lib/data';

export interface Props {
  gym: Gym;
  href?: string;
}

const { gym, href } = Astro.props;
const linkHref = href ?? `/${gym.brand_slug}-colchester-review/`;
---
<a href={linkHref} class="block bg-white border border-ink-900/10 rounded-xl p-5 hover:border-brand-300 transition no-underline">
  <div class="flex items-baseline justify-between">
    <p class="text-lg font-semibold text-ink-900">{gym.name}</p>
    <span class="pill">{gym.tier_label}</span>
  </div>
  <p class="text-sm text-ink-500 mt-1">{gym.open_hours_summary} · {gym.no_contract ? 'No contract' : '12-month contract'}</p>

  <div class="mt-3 flex items-baseline gap-3">
    <p class="text-2xl font-bold text-brand-700">{fmtMoney(gym.monthly_price_2026_gbp)}</p>
    <span class="text-xs text-ink-500">/month</span>
  </div>

  <div class="mt-4 flex flex-wrap gap-1.5">
    {gym.best_for.slice(0, 3).map((b) => (
      <span class="pill-good">{b}</span>
    ))}
  </div>

  {gym.underrated_for.length > 0 && (
    <p class="mt-4 text-xs text-ink-700 italic">"{gym.underrated_for[0]}"</p>
  )}

  <p class="mt-4 text-brand-700 text-sm font-medium">Read the honest review →</p>
</a>
