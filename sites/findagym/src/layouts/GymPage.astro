---
import BaseLayout from './BaseLayout.astro';

export interface Props {
  title: string;
  description: string;
  jsonLd?: object[];
  breadcrumbs?: Array<{ name: string; url: string }>;
}

const { title, description, jsonLd, breadcrumbs } = Astro.props;
---
<BaseLayout title={title} description={description} jsonLd={jsonLd} breadcrumbs={breadcrumbs}>
  <slot name="hero" />
  <div class="container-wide py-8 md:py-10 grid gap-6 md:gap-8">
    <slot />
  </div>
</BaseLayout>
