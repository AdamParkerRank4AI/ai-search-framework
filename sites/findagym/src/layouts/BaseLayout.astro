---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { organisationSchema, websiteSchema, breadcrumbSchema } from '../lib/schema';

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  jsonLd?: object[];
  breadcrumbs?: Array<{ name: string; url: string }>;
}

const { title, description, canonical, jsonLd = [], breadcrumbs } = Astro.props;
const siteUrl = 'https://findagym.co.uk';
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, siteUrl).toString();

const schemas = [
  organisationSchema(),
  websiteSchema(),
  ...(breadcrumbs ? [breadcrumbSchema(breadcrumbs)] : []),
  ...jsonLd,
];
---
<!DOCTYPE html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="FindAGym" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#c33936" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://rsms.me/" />
    <link rel="stylesheet" href="https://rsms.me/inter/inter.css" />
    {schemas.map((s) => (
      <script type="application/ld+json" set:html={JSON.stringify(s)} />
    ))}
    <slot name="head" />
  </head>
  <body class="min-h-screen bg-white text-ink-900 font-sans antialiased">
    <Header />
    <main class="pb-16">
      <slot />
    </main>
    <Footer />
  </body>
</html>
