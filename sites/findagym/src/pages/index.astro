---
import BaseLayout from '../layouts/BaseLayout.astro';
import { colchester } from '../lib/data';

const angleLinks = [
  { href: '/best-gyms-colchester/', label: 'Best gyms in Colchester' },
  { href: '/quietest-gyms-colchester/', label: 'Quietest gyms (when each is empty)' },
  { href: '/least-intimidating-gym-colchester/', label: 'Least intimidating for beginners' },
  { href: '/best-equipped-gym-colchester/', label: 'Best-equipped gyms' },
  { href: '/best-gym-classes-colchester/', label: 'Best gym classes' },
  { href: '/cheap-gyms-colchester/', label: 'Cheap gyms (under £25/mo)' },
  { href: '/24-hour-gyms-colchester/', label: '24-hour gyms' },
  { href: '/womens-gym-colchester/', label: 'Women-friendly gyms' },
];

const title = 'FindAGym — Honest UK gym reviews. When it's quiet, who goes, what the equipment is really like.';
const description = 'Independent UK gym reviews. We tell you what generic ranking sites won\'t: when each gym is quiet, who actually goes there, what the equipment is really like. Pilot live in Colchester.';
---
<BaseLayout title={title} description={description}>
  <section class="bg-gradient-to-b from-brand-50 to-white border-b border-ink-900/10">
    <div class="container-wide py-16 md:py-24">
      <p class="text-xs font-bold uppercase tracking-wider text-brand-700">UK gym reviews — pilot in Colchester</p>
      <h1 class="mt-3 text-4xl md:text-5xl font-bold text-ink-900 leading-tight max-w-3xl">
        When it's quiet. Who goes there. What the equipment is really like.
      </h1>
      <p class="mt-5 text-lg text-ink-700 max-w-2xl">
        Generic gym ranking sites tell you which is cheapest. We tell you the things buyers actually want to know — when each gym is empty, the real demographic mix, the equipment audit nobody else captures, and what each gym is genuinely underrated for.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/best-gyms-colchester/" class="btn-primary">Best gyms in Colchester →</a>
        <a href="/how-we-rate-gyms/" class="btn-secondary">How we rate</a>
      </div>
    </div>
  </section>

  <section class="container-wide py-12">
    <h2 class="text-2xl font-semibold text-ink-900 mb-6">Pick your angle</h2>
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-3">
      {angleLinks.map((a) => (
        <a href={a.href} class="block bg-white border border-ink-900/10 rounded-xl p-5 hover:border-brand-300 transition no-underline">
          <p class="text-base font-semibold text-ink-900">{a.label}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="container-wide py-12 grid md:grid-cols-3 gap-8 border-t border-ink-900/10">
    <div>
      <p class="text-3xl font-bold text-brand-700">Quiet times</p>
      <p class="mt-2 text-sm text-ink-700">Daily heatmap of every gym we cover — sourced from Google Maps Popular Times plus our own observation.</p>
    </div>
    <div>
      <p class="text-3xl font-bold text-brand-700">Demographics</p>
      <p class="mt-2 text-sm text-ink-700">Who actually goes there: gender split, age bands, beginner-to-advanced ratio, atmosphere read.</p>
    </div>
    <div>
      <p class="text-3xl font-bold text-brand-700">Equipment audit</p>
      <p class="mt-2 text-sm text-ink-700">Cardio counts, free-weight ceilings, squat racks, deadlift platforms, what's broken — every gym we visit.</p>
    </div>
  </section>

  <section class="container-wide py-12 border-t border-ink-900/10">
    <div class="flex items-baseline justify-between mb-6">
      <h2 class="text-2xl font-semibold text-ink-900">Coverage</h2>
      <p class="text-sm text-ink-500">{colchester.gyms.length} gyms reviewed in {colchester._town} so far</p>
    </div>
    <a href="/colchester/" class="block bg-white border border-ink-900/10 rounded-xl p-8 hover:border-brand-300 transition no-underline">
      <p class="text-2xl font-bold text-ink-900">{colchester._town}</p>
      <p class="mt-1 text-sm text-ink-500">{colchester._county}</p>
      <p class="mt-4 text-ink-700">Full reviews of {colchester.gyms.length} gyms and {colchester.specialism_studios.length} specialism studios — with quiet times, demographic profile, and the under-served angles nobody else covers.</p>
      <p class="mt-4 text-brand-700 font-medium">Browse {colchester._town} gyms →</p>
    </a>
    <p class="mt-6 text-sm text-ink-500">Next towns: Chelmsford, Ipswich, Cambridge, Romford, Southend (M2 wave).</p>
  </section>
</BaseLayout>
