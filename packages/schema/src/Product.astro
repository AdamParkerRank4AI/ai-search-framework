---
interface Props {
  name: string;
  description?: string;
  image?: string;
  brand?: string;
  sku?: string;
  offerPriceGBP?: number;
  offerUrl?: string;
  rating?: { value: number; count?: number; best?: number };
}
const { name, description, image, brand, sku, offerPriceGBP, offerUrl, rating } = Astro.props;
const data: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name,
  ...(description && { description }),
  ...(image && { image }),
  ...(brand && { brand: { '@type': 'Brand', name: brand } }),
  ...(sku && { sku }),
};
if (offerPriceGBP !== undefined) {
  data.offers = {
    '@type': 'Offer',
    price: offerPriceGBP,
    priceCurrency: 'GBP',
    ...(offerUrl && { url: offerUrl }),
    availability: 'https://schema.org/InStock',
  };
}
if (rating) {
  data.aggregateRating = {
    '@type': 'AggregateRating',
    ratingValue: rating.value,
    bestRating: rating.best ?? 5,
    ...(rating.count && { ratingCount: rating.count }),
  };
}
---
<script type="application/ld+json" set:html={JSON.stringify(data)} is:inline></script>
