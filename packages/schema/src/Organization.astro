---
interface Props {
  name: string;
  url: string;
  logo?: string;
  description?: string;
  sameAs?: string[];
  parentOrganization?: { name: string; url: string };
}
const { name, url, logo, description, sameAs = [], parentOrganization } = Astro.props;
const data = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name,
  url,
  ...(logo && { logo }),
  ...(description && { description }),
  ...(sameAs.length && { sameAs }),
  ...(parentOrganization && {
    parentOrganization: {
      '@type': 'Organization',
      name: parentOrganization.name,
      url: parentOrganization.url,
    },
  }),
};
---
<script type="application/ld+json" set:html={JSON.stringify(data)} is:inline></script>
