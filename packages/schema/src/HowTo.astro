---
interface Step { name: string; text: string; url?: string; }
interface Props {
  name: string;
  description: string;
  totalTime?: string; // ISO 8601 duration e.g. PT15M
  estimatedCostGBP?: number;
  steps: Step[];
}
const { name, description, totalTime, estimatedCostGBP, steps } = Astro.props;
const data: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name,
  description,
  ...(totalTime && { totalTime }),
  step: steps.map((s, i) => ({
    '@type': 'HowToStep',
    position: i + 1,
    name: s.name,
    text: s.text,
    ...(s.url && { url: s.url }),
  })),
};
if (estimatedCostGBP !== undefined) {
  data.estimatedCost = { '@type': 'MonetaryAmount', currency: 'GBP', value: estimatedCostGBP };
}
---
<script type="application/ld+json" set:html={JSON.stringify(data)} is:inline></script>
