---
interface Props { title?: string; }
const { title } = Astro.props;
---
{title && <h2 class="listicle-title">{title}</h2>}
<ol class="listicle">
  <slot />
</ol>
<style>
  .listicle-title { margin: 2rem 0 1rem; }
  .listicle { list-style: none; counter-reset: listicle; padding: 0; margin: 0; display: grid; gap: 1rem; }
</style>
