---
interface Row { [key: string]: string | number | null | undefined; }
interface Props {
  columns: { key: string; label: string }[];
  rows: Row[];
  caption?: string;
}
const { columns, rows, caption } = Astro.props;
---
<div class="cmp-wrap">
  {caption && <p class="cmp-caption">{caption}</p>}
  <table class="cmp">
    <thead>
      <tr>
        {columns.map((c) => <th scope="col">{c.label}</th>)}
      </tr>
    </thead>
    <tbody>
      {rows.map((r) => (
        <tr>
          {columns.map((c) => <td>{r[c.key] ?? '—'}</td>)}
        </tr>
      ))}
    </tbody>
  </table>
</div>
<style>
  .cmp-wrap { overflow-x: auto; margin: 1.5rem 0; }
  .cmp-caption { margin: 0 0 0.5rem; font-size: 0.9rem; color: var(--muted, #5a6270); }
  .cmp { width: 100%; border-collapse: collapse; font-size: 0.95rem; }
  .cmp th, .cmp td { padding: 0.65rem 0.85rem; text-align: left; border-bottom: 1px solid var(--border, #e3e6eb); vertical-align: top; }
  .cmp th { background: var(--surface-2, #f7f8fa); font-weight: 600; }
  .cmp tbody tr:hover { background: var(--surface-2, #fafbfc); }
</style>
