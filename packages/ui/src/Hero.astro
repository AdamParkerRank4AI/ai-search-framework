---
interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  lastUpdated?: string;
  authorName?: string;
  authorUrl?: string;
}
const { eyebrow, title, subtitle, lastUpdated, authorName, authorUrl } = Astro.props;
---
<section class="hero">
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h1>{title}</h1>
  {subtitle && <p class="subtitle">{subtitle}</p>}
  {(lastUpdated || authorName) && (
    <p class="meta">
      {authorName && (
        authorUrl ? <>By <a href={authorUrl}>{authorName}</a></> : <>By {authorName}</>
      )}
      {authorName && lastUpdated && ' · '}
      {lastUpdated && <>Updated {lastUpdated}</>}
    </p>
  )}
</section>
<style>
  .hero { padding: 2.5rem 0 1.5rem; }
  .eyebrow { text-transform: uppercase; font-size: 0.8rem; letter-spacing: 0.06em; color: var(--muted, #5a6270); margin: 0 0 0.75rem; }
  h1 { margin: 0 0 0.75rem; font-size: 2.25rem; line-height: 1.15; }
  .subtitle { margin: 0; color: var(--muted, #5a6270); font-size: 1.1rem; max-width: 680px; }
  .meta { margin: 1rem 0 0; color: var(--muted, #5a6270); font-size: 0.9rem; }
  .meta a { color: inherit; }
</style>
