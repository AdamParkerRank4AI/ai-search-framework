---
interface Faq { question: string; answer: string; }
interface Props { title?: string; faqs: Faq[]; }
const { title = 'Frequently asked questions', faqs } = Astro.props;
---
<section class="faq">
  <h2>{title}</h2>
  {faqs.map((f) => (
    <details>
      <summary>{f.question}</summary>
      <div class="answer" set:html={f.answer}></div>
    </details>
  ))}
</section>
<style>
  .faq { margin: 2.5rem 0; }
  .faq h2 { margin: 0 0 1rem; }
  details { border-bottom: 1px solid var(--border, #e3e6eb); padding: 0.75rem 0; }
  summary { cursor: pointer; font-weight: 600; padding: 0.4rem 0; }
  .answer { padding: 0.5rem 0 0.75rem; color: var(--text, #1a1d21); line-height: 1.6; }
</style>
